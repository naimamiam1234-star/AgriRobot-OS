[Unit]
Description=AgriRobot local development API
After=local-fs.target

[Service]
Environment=PATH=/opt/agrirobot/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Type=simple
User=agrirobot
Group=agrirobot
WorkingDirectory=/opt/agrirobot
ExecStart=/usr/bin/python3 -m app.server --data /var/lib/agrirobot
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/agrirobot

[Install]
WantedBy=multi-user.target
